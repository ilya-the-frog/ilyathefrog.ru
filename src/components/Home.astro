---
import { render } from 'astro:content';
import { getHome, formatDate, experience, type Language } from '../site';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const { profile, t, link, updated, publications, talks } = await getHome(lang);
const { Content: Bio } = await render(profile);
const site = Astro.site!;
const canonical = new URL(lang === 'ru' ? './' : 'en/', site);
const root = lang === 'ru' ? './' : '../';
---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-DYQXCMR5MV"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-DYQXCMR5MV');
    </script>
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO -->
    <meta
      name="keywords"
      content="Product Manager, Product, Продакт, Fintech, Финтех, Credit Cards, Кредитные карты, Retention, Удержание, Churn, Отток, Profitability Growth, Рост доходности, Customer Experience, Клиентский опыт, Service Journeys, Клиентские сценарии, Customer Support, Rocketbank, Рокетбанк, Yandex, Яндекс, T-Bank, Т-Банк, karta.io, Telegram, Travel, Путешествия, Илья Лягушенко, Ilya Lyagushenko, travelasproduct"
    />
    <meta
      name="description" content={profile.data.description}
    />
    <meta name="author" content="Ilya Lyagushenko" />

    <!-- Open Graph -->
    <meta property="og:locale" content={lang === "ru" ? "ru_RU" : "en_US"} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Ilya Lyagushenko | Product Manager & Travel" />
    <meta
      property="og:description" content={profile.data.description}
    />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Ilya Lyagushenko" />
    <meta property="og:image" content="https://ilyathefrog.ru/avatar.jpeg" />
    <meta property="og:image:secure_url" content="https://ilyathefrog.ru/avatar.jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpg" />

    <!-- Twitter/X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Ilya Lyagushenko | Product Manager & Travel" />
    <meta
      name="twitter:description" content={profile.data.description}
    />
    <meta name="twitter:image" content="https://ilyathefrog.ru/avatar.jpeg" />

    <script is:inline type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ProfilePage",
        "url": "https://ilyathefrog.ru/",
        "name": "Ilya Lyagushenko",
        "description": "Personal website of Ilya Lyagushenko, a fintech product manager focused on retention, churn, profitability growth, customer experience, and service journeys.",
        "inLanguage": ["ru", "en"],
        "mainEntity": {
          "@type": "Person",
          "name": "Ilya Lyagushenko",
          "alternateName": "Илья Лягушенко",
          "url": "https://ilyathefrog.ru/",
          "image": "https://ilyathefrog.ru/avatar.jpeg",
          "jobTitle": "Product Manager",
          "description": "Fintech product manager focused on retention, churn, profitability growth, customer experience, and service journeys. Started in customer support and moved into product management, and writes and speaks publicly about these topics.",
          "sameAs": [
            "https://t.me/travelasproduct",
            "https://www.linkedin.com/in/ilyathefrog/",
            "https://github.com/ilya-the-frog",
            "https://x.com/ilya_the_frog",
            "https://www.instagram.com/ilya-the-frog"
          ],
          "knowsAbout": [
            "Fintech",
            "Credit cards",
            "Retention",
            "Churn reduction",
            "Profitability growth",
            "Customer experience",
            "Customer support",
            "Service journeys",
            "Product management",
            "Travel"
          ]
        }
      }
    </script>

    <link href={root + "normalize.css"} rel="stylesheet" />
    <link href={root + "style.css?v=2026-11-16"} rel="stylesheet" />

    <link rel="icon" type="image/png" href={root + "favicon-96x96.png"} sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href={root + "favicon.svg"} />
    <link rel="shortcut icon" href={root + "favicon.ico"} />
    <link rel="apple-touch-icon" sizes="180x180" href={root + "apple-touch-icon.png"} />
    <meta name="apple-mobile-web-app-title" content="Ilya Frogushenko" />
    <link rel="manifest" href={root + "site.webmanifest"} />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ru" href={site} />
    <link rel="alternate" hreflang="en" href={new URL('en/', site)} />
    <link rel="alternate" hreflang="x-default" href={site} />
    <link rel="alternate" type="text/markdown" href={root + 'index.md'} />
    <link rel="service-doc" type="text/plain" href={root + 'llms.txt'} />
    {process.env.GITHUB_SHA && <meta name="build-commit" content={process.env.GITHUB_SHA} />}
    <title>Ilya Lyagushenko 🖤</title>
  </head>

  <body>
    <nav class="lang-toggle" aria-label={lang === 'ru' ? 'Язык сайта' : 'Site language'}>
      <a class:list={['lang-toggle__btn', { 'lang-toggle__btn--active': lang === 'ru' }]} href={root} lang="ru" hreflang="ru" aria-current={lang === 'ru' ? 'page' : undefined}>RU</a>
      <a class:list={['lang-toggle__btn', { 'lang-toggle__btn--active': lang === 'en' }]} href={root + 'en/'} lang="en" hreflang="en" aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
    </nav>

    <header class="header">
      <img src={root + "avatar.jpeg"} alt={t("header.avatar")} class="header__avatar" />
      <h1 class="header__title">{t("header.title")}</h1>
      <p class="header__subtitle">{t("header.subtitle")}</p>
      <p class="links__note"><span>{t("header.updated")}</span> <time datetime={updated}>{updated}</time></p>
    </header>

    <main>
      <!-- WORK WITH ME -->
      <section class="links">
        <h2 class="links__header">{t("work.title")}</h2>
        <div class="about-card">
          <p class="about-card__body">{t("work.text")}</p>
          <div class="work-cta">
            <a class="button-link" href={link("work.email")}>{t("work.email")}</a>
            <a class="button-link" href={link("work.telegram")}>{t("work.telegram")}</a>
          </div>
        </div>
      </section>

      <!-- ABOUT -->
      <section class="links about-section">
        <h2 class="links__header">{t("about.title")}</h2>
        <div class="about-card">
          <div class="about-card__intro">
            <Bio />
          </div>

          <ul class="about-proof" aria-label="Key facts">
            <li class="about-proof__item">
              <span class="about-proof__value">{t("about.proof.churn.value")}</span>
              <span class="about-proof__label">{t("about.proof.churn.label")}</span>
            </li>
            <li class="about-proof__item">
              <span class="about-proof__value">{t("about.proof.impact.value")}</span>
              <span class="about-proof__label">{t("about.proof.impact.label")}</span>
            </li>
            <li class="about-proof__item">
              <span class="about-proof__value" >{experience}</span>
              <span class="about-proof__label">{t("about.proof.experience.label")}</span>
            </li>
            <li class="about-proof__item">
              <span class="about-proof__value">{t("about.proof.team.value")}</span>
              <span class="about-proof__label">{t("about.proof.team.label")}</span>
            </li>
          </ul>
          <p class="links__note">{t("about.proof.note")}</p>

          <div class="about-block">
            <p class="about-block__label">{t("about.focus.label")}</p>
            <div class="about-grid">
              <article class="about-grid__item">
                <h3 class="about-grid__title">{t("about.focus.fintech.title")}</h3>
                <p class="about-grid__text">{t("about.focus.fintech.text")}</p>
              </article>
              <article class="about-grid__item">
                <h3 class="about-grid__title">{t("about.focus.retention.title")}</h3>
                <p class="about-grid__text">{t("about.focus.retention.text")}</p>
              </article>
              <article class="about-grid__item">
                <h3 class="about-grid__title">{t("about.focus.cx.title")}</h3>
                <p class="about-grid__text">{t("about.focus.cx.text")}</p>
              </article>
              <article class="about-grid__item">
                <h3 class="about-grid__title">{t("about.focus.leadership.title")}</h3>
                <p class="about-grid__text">{t("about.focus.leadership.text")}</p>
              </article>
            </div>
          </div>
        </div>
      </section>

      <!-- BEYOND WORK -->
      <section class="links">
        <h2 class="links__header">{t("projects.title")}</h2>
        <div class="about-card projects__intro">
          <p class="about-card__body">{t("projects.intro")}</p>
        </div>

        <div class="projects__group">
          <p class="about-block__label">{t("projects.travel.label")}</p>
          <div class="about-grid">
            <article class="about-grid__item">
              <h3 class="about-grid__title">
                <a class="projects__anchor" href={link("projects.travel.channel.title")}>{t("projects.travel.channel.title")}</a>
              </h3>
              <p class="about-grid__text">{t("projects.travel.channel.text")}</p>
            </article>

            <article class="about-grid__item">
              <h3 class="about-grid__title">
                <a class="projects__anchor" href={link("projects.travel.nomad.title")}>{t("projects.travel.nomad.title")}</a>
              </h3>
              <p class="about-grid__text">{t("projects.travel.nomad.text")}</p>
              <a class="projects__meta-link" href={link("projects.travel.nomad.note")}>{t("projects.travel.nomad.note")}</a>
            </article>

            <article class="about-grid__item">
              <h3 class="about-grid__title">
                <a class="projects__anchor" href={link("projects.travel.myfr.title")}>{t("projects.travel.myfr.title")}</a>
              </h3>
              <p class="about-grid__text">{t("projects.travel.myfr.text")}</p>
            </article>
          </div>
        </div>

        <div class="projects__group">
          <p class="about-block__label">{t("projects.side.label")}</p>
          <div class="about-grid">
            <article class="about-grid__item">
              <h3 class="about-grid__title">{t("projects.side.site.title")}</h3>
              <p class="about-grid__text">{t("projects.side.site.text")}</p>
              <a class="projects__meta-link" href={link("projects.side.site.repo")}>{t("projects.meta.github")}</a>
            </article>

            <article class="about-grid__item">
              <h3 class="about-grid__title">
                <a class="projects__anchor" href={link("projects.side.bot.title")}>{t("projects.side.bot.title")}</a>
              </h3>
              <p class="about-grid__text">{t("projects.side.bot.text")}</p>
              <a class="projects__meta-link" href={link("projects.side.bot.repo")}>{t("projects.meta.github")}</a>
            </article>
          </div>
        </div>
      </section>

      <section class="links">
        <h2 class="links__header">{t("about.audience.label")}</h2>
        <div class="about-card">
          <div class="about-audience">
            <article class="about-audience__item">
              <p class="about-audience__title">{t("about.audience.companies.title")}</p>
              <p class="about-audience__text">{t("about.audience.companies.text")}</p>
            </article>
            <article class="about-audience__item">
              <p class="about-audience__title">{t("about.audience.people.title")}</p>
              <p class="about-audience__text">{t("about.audience.people.text")}</p>
            </article>
            <article class="about-audience__item">
              <p class="about-audience__title">{t("about.audience.media.title")}</p>
              <p class="about-audience__text">{t("about.audience.media.text")}</p>
            </article>
          </div>
        </div>
      </section>

      <!-- CONTACTS -->
      <section class="links links--about">
        <h2 class="links__header">{t("contacts.title")}</h2>

        <ul class="links__container">
          <li class="links__link">
            <p class="links__title">{t("contacts.telegram.title")}</p>
            <a class="links__anchor" href={link("contacts.telegram.handle")}>
              <span class="link-logo link-logo--telegram" aria-hidden="true">
                <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
                  <path d="M28.2307 89.8987C79.5175 66.8612 145.887 38.7737 155.048 34.8862C179.08 24.7112 186.454 26.6612 182.777 49.1945C180.137 65.3903 172.518 119.011 166.446 152.386C162.842 172.178 154.758 174.524 142.047 165.961C135.934 161.84 105.079 141.007 98.3828 136.115C92.2699 131.657 83.839 126.295 94.4123 115.732C98.1747 111.97 122.839 87.9237 142.055 69.207C144.573 66.7487 141.41 62.7112 138.505 64.682C112.604 82.2195 76.6936 106.561 72.1232 109.732C65.2186 114.52 58.5874 116.715 46.6838 113.224C37.6898 110.586 28.904 107.44 25.4843 106.24C12.3157 101.624 15.4416 95.6445 28.2307 89.8987Z" />
                </svg>
              </span>
              <span>{t("contacts.telegram.handle")}</span>
            </a>
          </li>

          <li class="links__link">
            <p class="links__title">{t("contacts.linkedin.title")}</p>
            <a class="links__anchor" href={link("contacts.linkedin.handle")}>
              <span class="link-logo link-logo--linkedin" aria-hidden="true">
                <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
                  <path d="M165.151 17C170.063 17 174.773 18.9511 178.246 22.4241C181.719 25.897 183.67 30.6074 183.67 35.5189V165.151C183.67 170.063 181.719 174.773 178.246 178.246C174.773 181.719 170.063 183.67 165.151 183.67H35.5189C30.6074 183.67 25.897 181.719 22.4241 178.246C18.9511 174.773 17 170.063 17 165.151V35.5189C17 30.6074 18.9511 25.897 22.4241 22.4241C25.897 18.9511 30.6074 17 35.5189 17H165.151ZM160.521 160.521V111.446C160.521 103.441 157.341 95.7627 151.68 90.1018C146.019 84.4408 138.341 81.2605 130.336 81.2605C122.465 81.2605 113.298 86.0755 108.854 93.2978V83.0198H83.0198V160.521H108.854V114.872C108.854 107.743 114.595 101.909 121.724 101.909C125.162 101.909 128.46 103.275 130.891 105.706C133.322 108.137 134.688 111.434 134.688 114.872V160.521H160.521ZM52.9266 68.4825C57.0523 68.4825 61.009 66.8436 63.9263 63.9263C66.8436 61.009 68.4825 57.0523 68.4825 52.9266C68.4825 44.3154 61.5379 37.2782 52.9266 37.2782C48.7764 37.2782 44.7962 38.9269 41.8615 41.8615C38.9269 44.7962 37.2782 48.7764 37.2782 52.9266C37.2782 61.5379 44.3154 68.4825 52.9266 68.4825ZM65.7973 160.521V83.0198H40.1486V160.521H65.7973Z" />
                </svg>
              </span>
              <span>{t("contacts.linkedin.handle")}</span>
            </a>
          </li>

          <li class="links__link">
            <p class="links__title">{t("contacts.github.title")}</p>
            <a class="links__anchor" href={link("contacts.github.handle")}>
              <span class="link-logo link-logo--github" aria-hidden="true">
                <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
                  <path d="M183.333 100C183.333 137.333 158.833 168.917 125 179.5V158.333C125 151.208 122 144.833 117.25 140.25C139.083 136.292 150 123.583 150 100C150 89.7918 147.917 81.7084 143.833 75.4168C145.667 68.2918 146.75 58.1668 141.667 50.0001C131.833 50.0001 124.958 55.7918 120.917 60.5418C114.875 59.0834 107.917 58.3334 100 58.3334C92.5001 58.3334 85.5834 59.1668 79.4168 60.8751C75.4168 56.0834 68.4168 50.0001 58.3334 50.0001C52.4168 59.5001 54.8334 69.7501 57.0834 75.5001C52.5834 81.7918 50.0001 89.8751 50.0001 100C50.0001 123.583 60.9168 136.292 82.7501 140.25C79.9584 142.958 77.7918 146.25 76.4584 150H66.6668C60.6668 150 58.3334 147.333 55.1251 143C51.9167 138.667 48.4584 135.75 44.3334 134.542C42.1251 134.292 40.6251 136.083 42.5834 137.667C49.1251 142.375 49.5834 150.083 52.2084 155.125C54.5834 159.667 59.5001 162.5 65.0418 162.5H75.0001V179.5C41.1668 168.917 16.6667 137.333 16.6667 100C16.6667 53.9584 53.9584 16.6667 100 16.6667C146.042 16.6667 183.333 53.9584 183.333 100Z" />
                </svg>
              </span>
              <span>{t("contacts.github.handle")}</span>
            </a>
          </li>

          <li class="links__link">
            <p class="links__title">{t("contacts.scholar.title")}</p>
            <a class="links__anchor" href={link("contacts.scholar.handle")}><span>{t("contacts.scholar.handle")}</span></a>
          </li>

          <li class="links__link">
            <p class="links__title">{t("contacts.dzen.title")}</p>
            <a class="links__anchor" href={link("contacts.dzen.handle")}>
              <span class="link-logo link-logo--dzen" aria-hidden="true">
                <img src={root + "dzen-favicon.ico"} alt="" />
              </span>
              <span>{t("contacts.dzen.handle")}</span>
            </a>
          </li>

          <li class="links__link">
            <p class="links__title">{t("contacts.twitter.title")}</p>
            <a class="links__anchor" href={link("contacts.twitter.handle")}>
              <span class="link-logo link-logo--twitter" aria-hidden="true">
                <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
                  <path d="M187.167 49.9999C180.75 52.9166 173.833 54.8333 166.667 55.7499C174 51.3333 179.667 44.3333 182.333 35.9166C175.417 40.0833 167.75 42.9999 159.667 44.6666C153.083 37.4999 143.833 33.3333 133.333 33.3333C113.75 33.3333 97.75 49.3333 97.75 69.0833C97.75 71.9166 98.0833 74.6666 98.6667 77.2499C69 75.7499 42.5833 61.4999 25 39.9166C21.9167 45.1666 20.1667 51.3333 20.1667 57.8333C20.1667 70.2499 26.4167 81.2499 36.0833 87.4999C30.1667 87.4999 24.6667 85.8333 19.8333 83.3333C19.8333 83.3333 19.8333 83.3332 19.8333 83.5832C19.8333 100.917 32.1667 115.417 48.5 118.667C45.5 119.5 42.3333 119.917 39.0833 119.917C36.8333 119.917 34.5833 119.667 32.4167 119.25C36.9167 133.333 50 143.833 65.75 144.083C53.5833 153.75 38.1667 159.417 21.3333 159.417C18.5 159.417 15.6667 159.25 12.8333 158.917C28.6667 169.083 47.5 175 67.6667 175C133.333 175 169.417 120.5 169.417 73.2499C169.417 71.6666 169.417 70.1666 169.333 68.5832C176.333 63.5832 182.333 57.2499 187.167 49.9999Z" />
                </svg>
              </span>
              <span>{t("contacts.twitter.handle")}</span>
            </a>
          </li>

          <li class="links__link">
            <p class="links__title">{t("contacts.instagram.title")}</p>
            <a class="links__anchor" href={link("contacts.instagram.handle")}><span>{t("contacts.instagram.handle")}</span></a>
          </li>

          <li class="links__link">
            <p class="links__title">{t("contacts.email.title")}</p>
            <a class="links__anchor" href={link("contacts.email.handle")}>
              <span class="link-logo link-logo--email" aria-hidden="true">
                <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
                  <path d="M166.667 33.3333H33.3334C24.1251 33.3333 16.7501 40.7916 16.7501 49.9999L16.6667 150C16.6667 159.208 24.1251 166.667 33.3334 166.667H166.667C175.875 166.667 183.333 159.208 183.333 150V49.9999C183.333 40.7916 175.875 33.3333 166.667 33.3333ZM166.667 150H33.3334V66.6666L100 108.333L166.667 66.6666V150ZM100 91.6666L33.3334 49.9999H166.667L100 91.6666Z" />
                </svg>
              </span>
              <span>{t("contacts.email.handle")}</span>
            </a>
          </li>
        </ul>
        <p class="links__note">{t("contacts.instagram.note")}</p>
      </section>

      <!-- HELP -->
      <section class="links">
        <h2 class="links__header">{t("help.title")}</h2>
        <ul class="links__container">
          <li class="links__link">
            <p class="links__title">{t("help.consult.title")}</p>
            <a class="links__anchor" href={link("help.consult.link")}>{t("help.consult.link")}</a>
          </li>
          <li class="links__link">
            <p class="links__title">{t("help.mentoring.title")}</p>
            <a class="links__anchor" href={link("help.mentoring.link")}>{t("help.mentoring.link")}</a>
          </li>
          <li class="links__link">
            <p class="links__title">{t("help.content.title")}</p>
            <a class="links__anchor" href={link("help.content.link")}>{t("help.content.link")}</a>
          </li>
        </ul>
      </section>

      <!-- SPEAKER -->
      <section class="links">
        <h2 class="links__header">{t("speaker.title")}</h2>
        <ul class="links__container">
          {talks.map(({ data }) => (
            <li class="links__link">
              <p class="links__title">{data.title[lang]}</p>
              {data.links.map(link => <a class="links__anchor" href={link.url}>{link.label[lang]}</a>)}
            </li>
          ))}
        </ul>
      </section>

      <!-- PUBLICATIONS -->
      <section class="links">
        <h2 class="links__header">{t("publications.title")}</h2>
        <ul class="links__container">
          {publications.map(({ data }) => (
            <li class="links__link" data-pub-date={data.date}>
              <p class="links__title">{data.publisher[lang]}</p>
              <div class="links__body">
                <a class="links__anchor" href={data.url}>{data.title[lang]}</a>
                <time class="links__date" datetime={data.date}>{formatDate(data.date, lang)}</time>
              </div>
            </li>
          ))}
        </ul>
      </section>

    </main>

    <footer>
      <a class="button-link" href={link("footer.cta")}>{t("footer.cta")}</a>
    </footer>
  </body>
</html>
